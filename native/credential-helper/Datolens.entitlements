<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- DuckDB and its pinned httpfs extension have no Apple Team ID in local
       builds. Keep all other Hardened Runtime protections, including the ban
       on DYLD environment injection and attaching unsigned debuggers. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
